---
import SideMenu from '../components/sidemenu.astro';
import Ticker from '../components/ticker.astro';

const { pageTitle = "ameworm" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<div id="site-container">
			<div id="banner"><img style="width: 70%" src="/i/babylive.png"><ruby>AMEWORM<rt>amelian info center</rt></ruby></div>
			<Ticker />
			<div id="horizontals">
				<SideMenu />
				<slot />
			</div>
			<br>
			<slot name="below" />
		</div>
	</body>
</html>
